{
  "manifest_version": 2,
  "name": "Free Dictionary Lookup",
  "version": "1.0.1",
  "description": "Select any English word on a webpage to instantly see its meaning, pronunciation and examples in a clean popup. Powered by the Free Dictionary API.",
  "author": "Nahid",
  "homepage_url": "https://github.com/NahidAkhtar84/FreeDictionaryExtension",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png",
    "256": "icons/256.png"
  },
  "permissions": [
    "storage",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "scripts": ["shared.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_action": {
    "default_title": "Free Dictionary Lookup",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{91926569-c212-45f9-839a-53fea5acd6fe}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
